{
  "name": "invoice-kit",
  "version": "1.0.0",
  "description": "Invoice pricing library (money, tiered discounts, coupons, tax) hardened with Stryker mutation testing",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:baseline": "vitest run -c vitest.baseline.config.ts",
    "mutate": "stryker run",
    "mutate:baseline": "stryker run stryker.baseline.config.json",
    "example": "npm run build && node examples/demo.mjs",
    "coverage": "vitest run --coverage",
    "coverage:baseline": "vitest run -c vitest.baseline.config.ts --coverage"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
