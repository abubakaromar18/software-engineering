{
  "name": "undoable-text-editor",
  "version": "1.0.0",
  "description": "Command pattern text editor core with undo/redo stacks, typing coalescing, macro commands and memento snapshots.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node dist/demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
